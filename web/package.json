{
  "name": "beanywhere-web-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:draft": "tsc --noEmit && vite build --mode draft",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "^12.0.0",
    "heic-to": "1.5.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
